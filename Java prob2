import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner sc = new Scanner(System.in);
      int x = sc.nextInt();
      int y = sc.nextInt();
      int z = sc.nextInt();

      int mx;
      if(x > y){
        if(x > z){
          mx = x;
          }
          else{
            mx = z;
          
          }
      }
      else{
        if(y > z){
          mx = y;
        }
        else{
          mx = z;
        }
      }
      System.out.print(mx);
    }
}
